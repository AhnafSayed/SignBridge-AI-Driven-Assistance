# Raw training datasets: too large for version control, and some carry
# licenses that restrict redistribution (see docs/PROJECT_REPORT.md, 6.3).
# Trained model artifacts under ml/models/ are kept; only the raw source
# data is excluded.
/ml/data/
# Precomputed dataset-loading cache (multi-gigabyte .npz arrays) and the
# downloaded MediaPipe model asset used at dev/training time -- both are
# regenerable/redownloadable, neither is original project content.
/ml/.cache/
/ml/.models/

# Kept locally, not published to the public repo -- these belong to the
# academic report submission, not the app/ml source itself.
/docs/PROJECT_REPORT.md
/docs/figures/
/design/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS/editor cruft
.DS_Store
.idea/
*.iml

# Scratch space for building/staging a release APK before it's uploaded
# to a GitHub release -- the APK itself is a multi-hundred-MB binary that
# belongs on the releases page, never in version control.
/release_staging/
